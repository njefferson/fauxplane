node_modules/

# Raw OurAirports CSVs are never committed — only the filtered
# public/data/navdata.json is. scripts/build-navdata.mjs caches them here.
.cache/
*.csv

# ...but NOAA's official WMM test table IS committed. It is the fixture the
# magnetic model is held to, and a blanket *.csv rule would have silently
# dropped it — leaving a test file importing a fixture that is not in the repo.
!scripts/fixtures/*.csv

# Local preview renders from scripts/preview.mjs — not deployed.
.preview/

# Crash-safety backups from scripts/plant.mjs. Present only mid-run; if one
# survives, the next run restores from it.
.plant-backup/
